<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<register-automaton>
    <alphabet>
        <inputs>
            <symbol name="IPleaseAck"/>
            <symbol name="IFrame">
                <param type="int" name="p1"/>
                <param type="int" name="p2"/>
            </symbol>
        </inputs>
        <outputs>
            <symbol name="ONOK"/>
            <symbol name="OOut">
                <param type="int" name="p1"/>
            </symbol>
            <symbol name="OAck">
                <param type="int" name="p1"/>
            </symbol>
        </outputs>
    </alphabet>
    <constants>
        <constant type="int" name="c1">0</constant>
        <constant type="int" name="c2">1</constant>
    </constants>
    <globals>
        <variable type="int" name="r1">0</variable>
        <variable type="int" name="tmp_int_1">0</variable>
    </globals>
    <locations>
        <location name="l0" initial="true"/>
        <location name="l1"/>
        <location name="l2"/>
        <location name="l3"/>
        <location name="l4"/>
        <location name="l5"/>
        <location name="l6"/>
        <location name="l7"/>
        <location name="l8"/>
        <location name="l9"/>
        <location name="l10"/>
        <location name="l11"/>
        <location name="l12"/>
        <location name="l13"/>
    </locations>
    <transitions>
        <transition from="l0" to="l1" symbol="IPleaseAck">
            <assignments/>
        </transition>
        <transition from="l0" to="l1" symbol="IFrame">
            <guard> 'c1' != 'p2'</guard>
            <assignments/>
        </transition>
        <transition from="l0" to="l4" symbol="IFrame">
            <guard> 'c1' == 'p2'</guard>
            <assignments>
                <assign to="r1">p1</assign>
            </assignments>
        </transition>
        <transition from="l1" to="l0" symbol="ONOK">
            <assignments/>
        </transition>
        <transition from="l4" to="l5" symbol="OOut" params="tmp_int_1">
            <assignments>
                <assign to="tmp_int_1">r1</assign>
            </assignments>
        </transition>
        <transition from="l5" to="l6" symbol="IPleaseAck">
            <assignments/>
        </transition>
        <transition from="l5" to="l8" symbol="IFrame">
            <assignments/>
        </transition>
        <transition from="l6" to="l7" symbol="OAck" params="c2">
            <assignments/>
        </transition>
        <transition from="l7" to="l9" symbol="IPleaseAck">
            <assignments/>
        </transition>
        <transition from="l7" to="l9" symbol="IFrame">
            <guard> 'c2' != 'p2'</guard>
            <assignments/>
        </transition>
        <transition from="l7" to="l10" symbol="IFrame">
            <guard> 'c2' == 'p2'</guard>
            <assignments>
                <assign to="r1">p1</assign>
            </assignments>
        </transition>
        <transition from="l8" to="l5" symbol="ONOK">
            <assignments/>
        </transition>
        <transition from="l9" to="l7" symbol="ONOK">
            <assignments/>
        </transition>
        <transition from="l10" to="l11" symbol="OOut" params="tmp_int_1">
            <assignments>
                <assign to="tmp_int_1">r1</assign>
            </assignments>
        </transition>
        <transition from="l11" to="l12" symbol="IPleaseAck">
            <assignments/>
        </transition>
        <transition from="l11" to="l13" symbol="IFrame">
            <assignments/>
        </transition>
        <transition from="l12" to="l0" symbol="OAck" params="c1">
            <assignments/>
        </transition>
        <transition from="l13" to="l11" symbol="ONOK">
            <assignments/>
        </transition>
    </transitions>
</register-automaton>
