        <variable type="int" name="r1">0</variable>
        <variable type="int" name="tmp_int_1">0</variable>
        <variable type="int" name="tmp_int_2">0</variable>
    </globals>
    <locations>
        <location name="l0" initial="true"/>
        <location name="l1"/>
        <location name="l2"/>
        <location name="l3"/>
        <location name="l4"/>
        <location name="l5"/>
        <location name="l6"/>
        <location name="l7"/>
    </locations>
    <transitions>
        <transition from="l0" to="l1" symbol="IREAD">
            <assignments/>
        </transition>
        <transition from="l0" to="l4" symbol="IFrame">
            <assignments>
                <assign to="r1">p2</assign>
                <assign to="r2">p1</assign>
            </assignments>
        </transition>
        <transition from="l0" to="l5" symbol="ILOSE">
            <assignments/>
        </transition>
        <transition from="l1" to="l0" symbol="ONOK">
            <assignments/>
        </transition>
        <transition from="l4" to="l6" symbol="OOK">
            <assignments/>
        </transition>
        <transition from="l5" to="l0" symbol="OOK">
            <assignments/>
        </transition>
        <transition from="l6" to="l4" symbol="IFrame">
            <assignments>
                <assign to="r1">p2</assign>
                <assign to="r2">p1</assign>
            </assignments>
        </transition>
        <transition from="l6" to="l5" symbol="ILOSE">
            <assignments/>
        </transition>
        <transition from="l6" to="l7" symbol="IREAD">
            <assignments/>
        </transition>
        <transition from="l7" to="l0" symbol="OFrame" params="tmp_int_1,tmp_int_2">
            <assignments>
                <assign to="tmp_int_1">r2</assign>
                <assign to="tmp_int_2">r1</assign>
            </assignments>
        </transition>
    </transitions>
</register-automaton>
