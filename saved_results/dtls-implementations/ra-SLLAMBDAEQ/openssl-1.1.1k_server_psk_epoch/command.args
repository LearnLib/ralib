state-fuzzer-server

# SUT config
-protocol
DTLS12
-connect
localhost:${sul.port}
-startWait
200
-responseWait
50
-cmd
dtls-fuzzer/suts/openssl-${openssl.version}/apps/openssl s_server -psk 1234 -key dtls-fuzzer/experiments/keystore/rsa2048_key.pem -cert dtls-fuzzer/experiments/keystore/rsa2048_cert.pem -CAfile dtls-fuzzer/experiments/keystore/rsa2048_cert.pem -Verify 1 -accept ${sul.port} -dtls1_2 -mtu 5000

# learning config
-output
${output.ra}/openssl-${openssl.version}_server_psk_epoch
-learningAlgorithm
SLSTAR
-equivalenceAlgorithms
SAMPLED_TESTS_RA
-testFile
configs/dtls-implementations/tests/psk_epoch
-alphabet
configs/dtls-implementations/alphabets/psk_aes128_cbc_sha256_epoch.xml
-Doutput.ra=results/dtls-implementations/ra-SLLAMBDAEQ
-learningAlgorithm
SLLAMBDAEQ
