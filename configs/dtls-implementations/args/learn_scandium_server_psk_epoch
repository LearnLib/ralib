state-fuzzer-server

# SUT config
-connect
localhost:${sul.port}
-startWait
1000
-responseWait
100
-protocol
DTLS12
-cmd
java -jar dtls-fuzzer/suts/scandium-${scandium.version}-dtls-clientserver.jar -port ${sul.port} -trustLocation ${keystore}/ec_secp256r1.jks -trustPassword password -trustAlias dtls-fuzzer -keyLocation ${keystore}/ec_secp256r1.jks -keyPassword password -keyAlias dtls-fuzzer -timeout 20000000 -cipherSuites TLS_PSK_WITH_AES_128_CCM_8,TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256 -starterAddress localhost:${fuzzer.port}
-sulConfig
dtls-fuzzer/experiments/configs/scandium.config
-adapterPort
${fuzzer.port}
-processTrigger
START
-inputResponseTimeout
PSK_CLIENT_HELLO:150,FINISHED:150

# learning config
-alphabet
configs/dtls-implementations/alphabets/psk_aes128_ccm8_epoch.xml
-output
${output.ra}/scandium-${scandium.version}_server_psk_epoch
-learningAlgorithm
SLSTAR
-equivalenceAlgorithms
SAMPLED_TESTS_RA
-testFile
configs/dtls-implementations/tests/psk_epoch 
-ceReruns
3
-skipNonDetTests
